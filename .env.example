# Copy this file to ".env" and fill in your real keys.
# In VS Code:  cp .env.example .env   (mac/Linux)  or  copy .env.example .env  (Windows)

# Get a free key at https://console.groq.com/  ->  API Keys
GROQ_API_KEY=your_groq_key_here

# Which Groq model to use. Run `python check_models.py` to see what your
# account currently supports, then paste one here.
# Good current choices (mid-2026): openai/gpt-oss-120b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# Optional — only if you also want Google Gemini (not required)
GOOGLE_API_KEY=
